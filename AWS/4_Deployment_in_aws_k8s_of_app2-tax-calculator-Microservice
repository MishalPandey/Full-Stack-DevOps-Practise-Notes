Deployement of Microservice: app2-tax-calculator.

1--> service-b -->> app.yaml
        
		
		#We can use here ClusterIP kyuki service ko aws ke andar hi call karna hai aws ke bahar call kar rhe honge to LoadBalancer chahiye hoga. 
		
			apiVersion: apps/v1
			kind: Deployment
			metadata:
			  name: service-b
			spec:
			  replicas: 1
			  selector:
				matchLabels:
				  app: service-b
			  template:
				metadata:
				  labels:
					app: service-b
				spec:
				  containers:
					- name: service-b
					  image: mishalpandey/tax-calculator-service-b:1.0
					  ports:
						- containerPort: 4000
			---
			apiVersion: v1
			kind: Service
			metadata:
			  name: service-b
			spec:
			  selector:
				app: service-b
			  type: ClusterIP  
			  ports:
				- port: 4000
				  targetPort: 4000


2--> service-a  -->> app.yaml 

        #No change in app.yaml of service-b in respect to Kubernates Local app.yaml configuration for local deployement
		#Slight change in app.yaml of service-a in respect to Kubernates Local app.yaml configuration for local deployement,
		#here we have chnaged NodePort to LoadBalancer and
        #port to 80 because that is default port then we dont have to explicitely mention port in call.
		
        # changed Part- 
						#apiVersion: v1
						#kind: Service
						#metadata:
						#  name: service-a
						#spec:
						#  selector:
						#    app: service-a
						#  type: LoadBalancer
						#  ports:
						#    - port: 80
						#      targetPort: 3000		
						
			apiVersion: apps/v1
			kind: Deployment
			metadata:
			  name: service-a
			spec:
			  replicas: 1
			  selector:
				matchLabels:
				  app: service-a
			  template:
				metadata:
				  labels:
					app: service-a
				spec:
				  containers:
					- name: service-a
					  image: mishalpandey/tax-calculator-service-a:1.0
					  env:
						- name: TAX_SERVICE_URL
						  value: "http://service-b:4000"
					  ports:
						- containerPort: 3000
			---
			apiVersion: v1
			kind: Service
			metadata:
			  name: service-a
			spec:
			  selector:
				app: service-a
			  type: LoadBalancer
			  ports:
				- port: 80
				  targetPort: 3000
				  
				  
				  
